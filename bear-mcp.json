{
  "mcpServers": {
    "bear": {
      "command": "uv",
      "args": [
        "--directory",
        "/path/to/bear",
        "run",
        "bear-mcp",
        "--server",
        "http://IPADDRESS:8888"
      ],
      "description": "BEAR v1.4 - Binary Exploitation & Automated Reversing MCP Server",
      "timeout": 300,
      "alwaysAllow": []
    }
  }
}
